# WebSocket URL of the game server. Required for production builds.
# Without it: `pnpm dev` goes through the Vite proxy (/__server -> GAME_SERVER_ORIGIN,
# default http://localhost:2567); a build tries ws(s)://<page host>:2567.
# VITE_SERVER_URL=wss://my-game.colyseus.cloud
# Platform adapter: "web" (default) or "gamepush".
# VITE_PLATFORM=web
# Build id shown in the menu footer (set by CI, e.g. the git SHA).
# VITE_BUILD_ID=dev
# GamePush (used when VITE_PLATFORM=gamepush). Both values come from the GamePush panel.
# The public token is meant for the client; put real values in .env.local (not committed).
# VITE_GAMEPUSH_PROJECT_ID=
# VITE_GAMEPUSH_PUBLIC_TOKEN=
